<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8">
		<title>{{ information.eventName }}</title>
		<style>
			@page {
				size: A4 portrait;
				margin: 24px;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				padding: 0;
				color: #1c2733;
				background: #ffffff;
				font-family: DejaVu Sans, Arial, sans-serif;
				font-size: 12px;
				line-height: 1.45;
			}
			.ticket {
				width: 100%;
				overflow: hidden;
				background: #ffffff;
				border: 1px solid #dfe3e6;
				border-radius: 12px;
			}
			.ticketplus-bar {
				height: 4px;
				background: #284b63;
			}
			.header {
				padding: 26px 30px 22px;
				border-bottom: 1px solid #e7e9eb;
			}
			.header-table,
			.content-table,
			.details-table,
			.footer-table {
				width: 100%;
				border-collapse: collapse;
			}
			.logo-cell {
				width: 185px;
				vertical-align: middle;
			}
			.ticketplus-logo {
				display: block;
				width: 170px;
				height: auto;
			}
			.type-cell {
				text-align: right;
				vertical-align: middle;
			}
			.eyebrow {
				margin: 0 0 4px;
				color: #526879;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 1.6px;
				text-transform: uppercase;
			}
			.document-title {
				margin: 0;
				color: #1c2733;
				font-size: 19px;
				font-weight: 700;
			}
			.hero {
				padding: 31px 30px 28px;
				background: #ffffff;
				border-bottom: 1px solid #e7e9eb;
			}
			.event-name {
				margin: 0;
				color: #17212b;
				font-size: 27px;
				line-height: 1.2;
			}
			.event-rule {
				width: 34px;
				height: 2px;
				margin-top: 16px;
				background: #284b63;
			}
			.content {
				padding: 29px 30px 24px;
			}
			.information-cell {
				padding-right: 30px;
				vertical-align: top;
			}
			.qr-cell {
				width: 182px;
				padding-left: 28px;
				text-align: center;
				vertical-align: top;
				border-left: 1px dashed #c8cdd1;
			}
			.section-title {
				margin: 0 0 16px;
				color: #68737d;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 1.4px;
				text-transform: uppercase;
			}
			.details-table td {
				width: 50%;
				padding: 0 14px 20px 0;
				vertical-align: top;
			}
			.label {
				display: block;
				margin-bottom: 4px;
				color: #7a838b;
				font-size: 9px;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
			}
			.value {
				display: block;
				color: #1c2733;
				font-size: 15px;
				font-weight: 700;
			}
			.price {
				color: #284b63;
				font-size: 20px;
			}
			.tax-note {
				display: block;
				margin-top: 3px;
				color: #7a838b;
				font-size: 9px;
				font-weight: 400;
			}
			.qr-frame {
				display: inline-block;
				padding: 9px;
				background: #ffffff;
				border: 1px solid #d7dbde;
				border-radius: 8px;
			}
			.qr-image {
				display: block;
				width: 132px;
				height: 132px;
			}
			.qr-help {
				margin: 10px 0 0;
				color: #6d7780;
				font-size: 9px;
				line-height: 1.35;
			}
			.access-reference {
				margin-top: 15px;
				padding: 10px 7px 9px;
				color: #284b63;
				background: #f4f5f5;
				border: 1px solid #e3e5e6;
				border-radius: 5px;
			}
			.access-reference-label {
				display: block;
				margin-bottom: 4px;
				color: #7a838b;
				font-size: 8px;
				font-weight: 700;
				letter-spacing: 0.9px;
				text-transform: uppercase;
			}
			.access-reference-value {
				display: block;
				font-family: DejaVu Sans Mono, monospace;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: 0.7px;
				word-break: break-all;
			}
			.notice {
				margin: 0 30px 27px;
				padding: 15px 18px;
				color: #59636b;
				background: #f6f6f4;
				border-left: 3px solid #8a969f;
				border-radius: 0 5px 5px 0;
				font-size: 10px;
			}
			.notice strong {
				color: #1c2733;
			}
			.footer {
				padding: 16px 30px;
				color: #788189;
				background: #ffffff;
				border-top: 1px solid #e7e9eb;
				font-size: 9px;
			}
			.footer-message {
				color: #59636b;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<main class="ticket">
			<div class="ticketplus-bar"></div>
			<header class="header">
				<table class="header-table" role="presentation">
					<tr>
						<td class="logo-cell">
							<img class="ticketplus-logo" src="{{ ticketplus_logo() }}" alt="Ticket+">
						</td>
						<td class="type-cell">
							<p class="eyebrow">Documento de acceso</p>
							<p class="document-title">Entrada digital</p>
						</td>
					</tr>
				</table>
			</header>
			<section class="hero">
				<p class="eyebrow">Tu próximo evento</p>
				<h1 class="event-name">{{ information.eventName }}</h1>
				<div class="event-rule"></div>
			</section>
			<section class="content">
				<table class="content-table" role="presentation">
					<tr>
						<td class="information-cell">
							<p class="section-title">Información de la entrada</p>
							<table class="details-table" role="presentation">
								<tr>
									<td>
										<span class="label">Fecha</span>
										<span class="value">{{ information.date }}</span>
									</td>
									<td>
										<span class="label">Zona</span>
										<span class="value">{{ information.zoneName }}</span>
									</td>
								</tr>
								<tr>
									<td>
										<span class="label">Asiento</span>
										<span class="value">{{ information.seatCode is not empty ? information.seatCode : 'No numerado' }}</span>
									</td>
									<td>
										<span class="label">Precio</span>
										<span class="value price">{{ currency }} {{ price|number_format(2, '.', ',') }}</span>
										<span class="tax-note">Impuestos no incluidos</span>
									</td>
								</tr>
							</table>
						</td>
						<td class="qr-cell">
							<p class="section-title">Código de ingreso</p>
							<div class="qr-frame">
								<img class="qr-image" src="{{ qr_code(qrCode) }}" alt="Código QR de acceso">
							</div>
							<p class="qr-help">Presenta este código QR en el acceso al evento.</p>
							<div class="access-reference">
								<span class="access-reference-label">Código de entrada</span>
								<span class="access-reference-value">{{ code }}</span>
							</div>
						</td>
					</tr>
				</table>
			</section>
			<aside class="notice">
				<strong>Importante:</strong>
				esta entrada es única. Evita compartir el código QR y ten este documento listo al llegar al evento.
			</aside>
			<footer class="footer">
				<table class="footer-table" role="presentation">
					<tr>
						<td class="footer-message">Ticket+ · Lo que vas a recordar empieza aquí.</td>
					</tr>
				</table>
			</footer>
		</main>
	</body>
</html>
